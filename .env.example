# Port the sync service listens on. The app expects http://localhost:8787.
PORT=8787

# CORS allowlist (comma-separated). LEAVE UNSET for local dev: by default the service
# accepts any localhost/127.0.0.1 origin on any port, so Vite port-hopping
# (5173 -> 5174 -> ...) just works. Set this to lock CORS to an explicit list.
# APP_ORIGIN=http://localhost:5173,http://localhost:5180

# Use offline fixtures instead of hitting a real backend, for live-fetch connectors.
# 1 = fixtures (default); 0 = live backend. The Acme dev backend is always
# in-process and ignores this flag. (No live-fetch connector is registered today;
# credentials for one belong here in the service env, never in the app.)
MOCK=1
