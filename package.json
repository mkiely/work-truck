{
  "name": "work-truck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local sync service for the Release Tracker app. Anti-corruption layer that translates external backends (HTTP or CLI) into the app-owned Sync Contract.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "start:prod": "NODE_ENV=production tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "gen:contract": "openapi-typescript node_modules/release-tracker/sync-contract/openapi.yaml -o src/contract.generated.ts",
    "gen:contract:local": "openapi-typescript ../release-tracker/packages/sync-contract/openapi.yaml -o src/contract.generated.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "execa": "^9.5.2",
    "hono": "^4.6.14",
    "release-tracker": "https://github.com/mkiely/release-tracker/releases/download/v0.3.0/release-tracker-0.3.0.tgz",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "openapi-typescript": "^7.4.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.0"
  }
}
