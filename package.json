{
  "name": "work-truck",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "Local sync service for the Release Tracker app. Anti-corruption layer that translates external backends (HTTP or CLI) into the app-owned Sync Contract.",
  "main": "./dist/sdk.js",
  "types": "./dist/sdk.d.ts",
  "exports": {
    ".": {
      "types": "./dist/sdk.d.ts",
      "default": "./dist/sdk.js"
    },
    "./conformance": {
      "types": "./dist/connectors/conformance.d.ts",
      "default": "./dist/connectors/conformance.js"
    }
  },
  "files": [
    "dist",
    "CONNECTORS.md"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json && rm -rf dist/app && cp -R node_modules/release-tracker/dist dist/app",
    "prepare": "npm run build",
    "start:prod": "NODE_ENV=production tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "gen:contract": "openapi-typescript node_modules/release-tracker/sync-contract/openapi.yaml -o src/contract.generated.ts",
    "gen:contract:local": "openapi-typescript ../release-tracker/packages/sync-contract/openapi.yaml -o src/contract.generated.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "execa": "^9.5.2",
    "hono": "^4.6.14",
    "zod": "^3.24.1"
  },
  "peerDependencies": {
    "vitest": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "openapi-typescript": "^7.4.4",
    "release-tracker": "https://github.com/mkiely/release-tracker/releases/download/v0.3.9/release-tracker-0.3.9.tgz",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.0"
  }
}
